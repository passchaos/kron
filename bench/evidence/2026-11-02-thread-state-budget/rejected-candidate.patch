diff --git a/src/core/tests/runtime_thread_state.zig b/src/core/tests/runtime_thread_state.zig
new file mode 100644
index 0000000..8400c22
--- /dev/null
+++ b/src/core/tests/runtime_thread_state.zig
@@ -0,0 +1,110 @@
+//! Thread-only state must follow the configured budget, not the 64-slot limit.
+const std = @import("std");
+const Runtime = @import("../runtime.zig").Runtime;
+const ThreadState = @import("../runtime.zig").ThreadState;
+const MemorySink = @import("../../sink/memory.zig").MemorySink;
+const ThreadLogger = @import("../logger.zig").Logger(@import("../thread_registry.zig").ThreadOwner(Runtime), .trace);
+
+test "runtime thread state ordinary modes allocate no channel state and emit without allocations" {
+    inline for (.{ "sync", "memory", "mmap" }) |mode| {
+        var tmp = std.testing.tmpDir(.{});
+        defer tmp.cleanup();
+        var path_bytes: [192]u8 = undefined;
+        const path = try std.fmt.bufPrint(&path_bytes, ".zig-cache/tmp/{s}/thread-state.journal", .{tmp.sub_path});
+        var bytes: [8192]u8 = undefined;
+        var sink = MemorySink.initBuffer(&bytes);
+        var allocator = std.testing.FailingAllocator.init(std.testing.allocator, .{});
+        const sync = comptime std.mem.eql(u8, mode, "sync");
+        const mmap = comptime std.mem.eql(u8, mode, "mmap");
+        const runtime = try Runtime.create(allocator.allocator(), std.testing.io, .{
+            .submission = if (sync) .sync else .asynchronous,
+            .memory_queue = if (!sync and !mmap) .{ .capacity = 8, .max_record_bytes = 512 } else null,
+            .journal = if (mmap) .{ .path = path, .capacity = 8, .max_record_bytes = 512 } else null,
+            .routes = &.{.{ .name = "memory", .sink = sink.sink(), .recovery_identity = "thread-state" }},
+        });
+        var live = true;
+        defer if (live) runtime.destroy();
+        try std.testing.expectEqual(@as(usize, 0), runtime.thread_states.len);
+        try std.testing.expect(runtime.thread_registry == null);
+        allocator.fail_index = allocator.alloc_index;
+        allocator.resize_fail_index = allocator.resize_index;
+        _ = try runtime.scoped("ordinary").tryEmit(.info, "no thread state", .{});
+        try runtime.reloadFilter("debug");
+        try runtime.flush(.written);
+        try runtime.shutdown(.drain);
+        try std.testing.expectEqual(@as(u64, 1), runtime.health().written);
+        try std.testing.expect(!allocator.has_induced_failure);
+        runtime.destroy();
+        live = false;
+        try std.testing.expectEqual(allocator.allocated_bytes, allocator.freed_bytes);
+    }
+}
+
+test "runtime thread state allocated budgets cover one four and sixty-four channels with stable pins" {
+    inline for (.{ 1, 4, 64 }) |budget| {
+        var bytes: [32768]u8 = undefined;
+        var sink = MemorySink.initBuffer(&bytes);
+        var allocator = std.testing.FailingAllocator.init(std.testing.allocator, .{});
+        const runtime = try Runtime.create(allocator.allocator(), std.testing.io, .{
+            .submission = .low_latency,
+            .memory_queue = .{ .capacity = 2, .max_record_bytes = 512 },
+            .max_thread_channels = budget,
+            .thread_channel_capacity = 2,
+            .routes = &.{.{ .name = "memory", .sink = sink.sink() }},
+        });
+        var live = true;
+        defer if (live) runtime.destroy();
+        try std.testing.expectEqual(@as(usize, budget), runtime.thread_states.len);
+        try std.testing.expectEqual(@as(usize, 0), @intFromPtr(runtime.thread_states.ptr) % @alignOf(ThreadState));
+        const original_address = runtime.thread_states.ptr;
+        allocator.fail_index = allocator.alloc_index;
+        allocator.resize_fail_index = allocator.resize_index;
+        var loggers: [64]?ThreadLogger = @splat(null);
+        defer for (loggers) |logger| if (logger) |log| log.detach() catch {};
+        for (loggers[0..budget], 0..) |*logger, index| {
+            logger.* = try runtime.attachThread(.{ .scope = "thread" });
+            try std.testing.expect(logger.*.?.enabled(.info));
+            _ = try logger.*.?.tryEmit(.info, "state", .{ .id = @as(u32, @intCast(index)) });
+            try std.testing.expect(runtime.thread_states[index].configuration.snapshot != null);
+        }
+        try std.testing.expectError(error.ChannelsExhausted, runtime.attachThread(.{ .scope = "extra" }));
+        for (loggers[0..budget]) |*logger| {
+            try logger.*.?.detach();
+            logger.* = null;
+        }
+        try runtime.flush(.written);
+        try std.testing.expectEqual(original_address, runtime.thread_states.ptr);
+        for (runtime.thread_states) |*state| {
+            try std.testing.expectEqual(@as(u64, 1), state.counters.accepted.load(.monotonic));
+            try std.testing.expectEqual(@as(u64, 1), state.counters.written.load(.monotonic));
+            try std.testing.expect(state.configuration.snapshot == null);
+        }
+        try runtime.shutdown(.drain);
+        try std.testing.expectEqual(@as(u64, budget), runtime.health().written);
+        try std.testing.expect(!allocator.has_induced_failure);
+        runtime.destroy();
+        live = false;
+        try std.testing.expectEqual(allocator.allocated_bytes, allocator.freed_bytes);
+    }
+}
+
+fn allocationCase(allocator: std.mem.Allocator) !void {
+    var bytes: [8192]u8 = undefined;
+    var sink = MemorySink.initBuffer(&bytes);
+    const runtime = try Runtime.create(allocator, std.testing.io, .{
+        .submission = .low_latency,
+        .memory_queue = .{ .capacity = 2, .max_record_bytes = 512 },
+        .max_thread_channels = 4,
+        .thread_channel_capacity = 2,
+        .routes = &.{.{ .name = "memory", .sink = sink.sink() }},
+    });
+    defer runtime.destroy();
+    const log = try runtime.attachThread(.{ .scope = "rollback" });
+    _ = try log.tryEmit(.info, "valid", .{});
+    try log.detach();
+    try runtime.shutdown(.drain);
+}
+
+test "runtime thread state allocation rollback frees the combined channel block" {
+    try std.testing.checkAllAllocationFailures(std.testing.allocator, allocationCase, .{});
+}
