+test "fused key scratch compact overlay retains unused bytes and exact comparison order for byte keys" {
+    const long_first: [257]u8 = @splat('a');
+    var long_last = long_first;
+    long_last[256] = 'b';
+    var all_bytes: [256]u8 = undefined;
+    for (&all_bytes, 0..) |*byte, index| byte.* = @intCast(index);
+    const keys = [_][]const u8{ "", &long_first, &all_bytes, &long_last, "\xff\x00" };
+    var entries: [5]field.Field = undefined;
+    @memset(std.mem.sliceAsBytes(&entries), 0xa5);
+    const empty = KeyScratch.init(entries[0..0]);
+    try std.testing.expectEqual(@as(usize, 0), empty.entries.len);
+    try expectUnusedKeyBytes(&entries, 0);
+    const scratch = KeyScratch.init(&entries);
+    const before = field.TestingAudit.compared_keys;
+    for (keys, 0..) |key, index| try scratch.append(index, key);
+    try std.testing.expectEqual(before + 10, field.TestingAudit.compared_keys);
+    for (scratch.entries, keys) |entry, key| try std.testing.expectEqualSlices(u8, key, entry);
+    try expectUnusedKeyBytes(&entries, keys.len);
+    for (keys[0..4], 0..) |key, index| {
+        const prior = field.TestingAudit.compared_keys;
+        const saved_key = scratch.entries[4];
+        try std.testing.expectError(error.DuplicateKey, scratch.append(4, key));
+        try std.testing.expectEqual(prior + index + 1, field.TestingAudit.compared_keys);
+        try std.testing.expectEqualSlices(u8, saved_key, scratch.entries[4]);
+        try expectUnusedKeyBytes(&entries, keys.len);
+    }
+}
+
+test "fused key scratch compact overlay preserves unused bytes on success duplicate invalid value and decode reuse" {
+    const Event = @import("../core/event.zig").Event;
+    const event: Event = .{ .level = .info, .scope = "scratch", .message = "value", .timestamp_ns = 0, .fields = &.{ field.kv("a", true), field.kv("b", false), field.kv("c", true) } };
+    var payload_bytes: [512]u8 = undefined;
+    const payload = try codec.encode(event, &payload_bytes);
+    const header = try codec.readHeader(payload, codec.version);
+    var parser: codec.WireInput = .{ .bytes = payload, .position = header.header_bytes };
+    _ = try parser.blob();
+    _ = try parser.blob();
+    _ = try parser.blob();
+    _ = try parser.value();
+    const second_key = try parser.blob();
+    const second_offset = @intFromPtr(second_key.ptr) - @intFromPtr(payload.ptr);
+    var changed: [512]u8 = undefined;
+    var output: [2048]u8 = undefined;
+    var scratch: [5]field.Field = undefined;
+    inline for (std.enums.values(Format)) |format| {
+        @memset(std.mem.sliceAsBytes(&scratch), 0xa5);
+        const before = field.TestingAudit.compared_keys;
+        _ = try render(format, payload, header, &output, &scratch, null);
+        try std.testing.expectEqual(before + 3, field.TestingAudit.compared_keys);
+        for (KeyScratch.init(scratch[0..3]).entries, event.fields) |entry, original| try std.testing.expectEqualSlices(u8, original.key, entry);
+        try expectUnusedKeyBytes(&scratch, 3);
+        const decoded = try codec.decode(payload, &scratch);
+        var reencoded: [512]u8 = undefined;
+        try std.testing.expectEqualSlices(u8, payload, try codec.encode(decoded, &reencoded));
+
+        @memcpy(changed[0..payload.len], payload);
+        changed[second_offset] = 'a';
+        @memset(std.mem.sliceAsBytes(&scratch), 0xa5);
+        const duplicate_before = field.TestingAudit.compared_keys;
+        try std.testing.expectError(error.DuplicateKey, render(format, changed[0..payload.len], header, &output, &scratch, null));
+        try std.testing.expectEqual(duplicate_before + 1, field.TestingAudit.compared_keys);
+        try std.testing.expectEqualStrings("a", KeyScratch.init(scratch[0..3]).entries[0]);
+        try expectUnusedKeyBytes(&scratch, 1);
+        _ = try codec.decode(payload, &scratch);
+        try std.testing.expect(!scratch[1].value.boolean);
+
+        @memcpy(changed[0..payload.len], payload);
+        changed[payload.len - 1] = 2;
+        @memset(std.mem.sliceAsBytes(&scratch), 0xa5);
+        const invalid_before = field.TestingAudit.compared_keys;
+        try std.testing.expectError(error.InvalidValue, render(format, changed[0..payload.len], header, &output, &scratch, null));
+        try std.testing.expectEqual(invalid_before + 3, field.TestingAudit.compared_keys);
+        try expectUnusedKeyBytes(&scratch, 3);
+        _ = try codec.decode(payload, &scratch);
+        try std.testing.expect(scratch[2].value.boolean);
+    }
+    var deferred = event;
+    deferred.message_template = true;
+    const fallback = try codec.encode(deferred, &changed);
+    const fallback_header = try codec.readHeader(fallback, codec.version);
+    @memset(std.mem.sliceAsBytes(&scratch), 0xa5);
+    try std.testing.expectError(error.Fallback, render(.json, fallback, fallback_header, &output, &scratch, null));
+    try std.testing.expect(std.mem.allEqual(u8, std.mem.sliceAsBytes(&scratch), 0xa5));
+    const decoded = try codec.decode(fallback, &scratch);
+    try std.testing.expect(decoded.message_template and decoded.fields[0].value.boolean);
+}
