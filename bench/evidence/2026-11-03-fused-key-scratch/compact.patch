+fn expectUnusedKeyBytes(backing: []const field.Field, initialized: usize) !void {
+    // The prefix is a key-slice overlay, not valid Fields. Inspect only bytes
+    // beyond its initialized keys; full codec.decode restores Field semantics.
+    const bytes = std.mem.sliceAsBytes(backing);
+    try std.testing.expect(std.mem.allEqual(u8, bytes[initialized * @sizeOf([]const u8) ..], 0xa5));
+}
