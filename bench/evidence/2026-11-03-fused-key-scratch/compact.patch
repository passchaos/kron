 pub const Error = schema_codec.DecodeError || std.Io.Writer.Error || error{Fallback};
 pub const Format = enum { json, text, logfmt };
 
+/// Compact keys overlay the leading bytes of the original top-level Field
+/// budget. Only entries[0..index] are initialized; this prefix must not be read
+/// as Fields until a full decode initializes it again. Nested storage remains
+/// after the entire top-level Field budget, including its unused bytes.
+const KeyScratch = struct {
+    entries: [][]const u8,
+
+    inline fn init(backing: []field.Field) KeyScratch {
+        comptime {
+            std.debug.assert(@sizeOf(field.Field) >= @sizeOf([]const u8));
+            std.debug.assert(@alignOf(field.Field) >= @alignOf([]const u8));
+        }
+        const bytes = std.mem.sliceAsBytes(backing);
+        // The valid Field slice establishes its larger byte budget first, so
+        // the smaller key-slice prefix cannot overflow or exceed that backing.
+        return .{ .entries = std.mem.bytesAsSlice([]const u8, bytes[0 .. backing.len * @sizeOf([]const u8)]) };
+    }
+
+    inline fn append(self: KeyScratch, index: usize, key: []const u8) error{DuplicateKey}!void {
+        for (self.entries[0..index]) |entry| {
+            if (@import("builtin").is_test) field.TestingAudit.compared_keys += 1;
+            if (std.mem.eql(u8, entry, key)) return error.DuplicateKey;
+        }
+        self.entries[index] = key;
+    }
+};
