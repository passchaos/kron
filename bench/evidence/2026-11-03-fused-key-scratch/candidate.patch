+/// A key-only view over the original Field backing and stride. Only the first
+/// `index` keys are initialized; Value bytes remain caller-owned scratch and
+/// must never be read, copied or initialized while recording top-level keys.
+const KeyScratch = struct {
+    entries: []field.Field,
+
+    inline fn append(self: KeyScratch, index: usize, key: []const u8) error{DuplicateKey}!void {
+        for (self.entries[0..index]) |*entry| {
+            if (@import("builtin").is_test) field.TestingAudit.compared_keys += 1;
+            if (std.mem.eql(u8, entry.key, key)) return error.DuplicateKey;
+        }
+        self.entries[index].key = key;
+    }
+};
