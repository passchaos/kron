+fn expectPoisonValues(entries: []const field.Field) !void {
+    // Inspect only initialized poison bytes, never interpret the invalid union
+    // tag as a Value. A successful codec.decode later initializes whole Fields.
+    for (entries) |*entry| try std.testing.expect(std.mem.allEqual(u8, std.mem.asBytes(&entry.value), 0xa5));
+}
