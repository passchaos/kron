+/// Safe whole-record entry point. Borrowed event storage must remain unchanged
+/// for this call, including during writer callbacks. Validation cannot escape
+/// the call; the recursive renderer remains private.
+pub fn encode(comptime format: RecordFormat, event: Event, writer: *std.Io.Writer) std.Io.Writer.Error!void {
+    try validateEvent(event);
+    switch (format) {
+        .text => try encodeText(event, writer),
+        .json => try encodeJson(event, writer),
+        .logfmt => try encodeLogfmt(event, writer),
+    }
+}
+
+fn encodeJson(event: Event, writer: *std.Io.Writer) std.Io.Writer.Error!void {
+    try writer.writeAll("{\"timestamp_ns\":");
+    try valueInner(writer, .{ .timestamp_ns = event.timestamp_ns }, .json);
+    try writer.writeAll(",\"severity\":");
+    try quoted(writer, @tagName(event.level), .json);
+    try writer.writeAll(",\"scope\":");
+    try quoted(writer, event.scope, .json);
+    try writer.writeAll(",\"message\":");
+    try message(writer, event, .json);
+    try writer.writeAll(",\"session\":");
+    try valueInner(writer, .{ .unsigned = event.session }, .json);
+    try writer.print(",\"channel\":{d},\"sequence\":", .{event.channel});
+    try valueInner(writer, .{ .unsigned = event.sequence }, .json);
+    try writer.writeAll(",\"route_mask\":");
+    try valueInner(writer, .{ .unsigned = event.route_mask }, .json);
+    try writer.writeAll(",\"config_generation\":");
+    try valueInner(writer, .{ .unsigned = event.config_generation }, .json);
+    try writer.print(",\"trace_flags\":{d}", .{event.trace_flags});
+    if (event.trace_id) |id| {
+        try writer.writeAll(",\"trace_id\":\"");
+        try hex(writer, &id);
+        try writer.writeByte('"');
+    }
+    if (event.span_id) |id| {
+        try writer.writeAll(",\"span_id\":\"");
+        try hex(writer, &id);
+        try writer.writeByte('"');
+    }
+    if (event.source) |source| {
+        try writer.writeAll(",\"source\":{\"module\":");
+        try quoted(writer, source.module, .json);
+        try writer.writeAll(",\"file\":");
+        try quoted(writer, source.file, .json);
+        try writer.writeAll(",\"function\":");
+        try quoted(writer, source.fn_name, .json);
+        try writer.print(",\"line\":{d},\"column\":{d}}}", .{ source.line, source.column });
+    }
+    try writer.writeAll(",\"attributes\":{");
+    for (event.fields, 0..) |field, index| {
+        if (index != 0) try writer.writeByte(',');
+        try jsonKey(writer, field.key);
+        try writer.writeByte(':');
+        try valueInner(writer, field.value, .json);
+    }
+    try writer.writeAll("}}\n");
+}
+
+fn encodeText(event: Event, writer: *std.Io.Writer) std.Io.Writer.Error!void {
+    try writer.print("{d} {s} scope=", .{ event.timestamp_ns, @tagName(event.level) });
+    try quoted(writer, event.scope, .text);
+    try writer.writeAll(" message=");
+    try message(writer, event, .text);
+    try writer.print(" session={d} channel={d} sequence={d}", .{ event.session, event.channel, event.sequence });
+    if (event.trace_id) |id| {
+        try writer.writeAll(" trace_id=");
+        try hex(writer, &id);
+    }
+    if (event.span_id) |id| {
+        try writer.writeAll(" span_id=");
+        try hex(writer, &id);
+    }
+    if (event.source) |source| {
+        try writer.writeAll(" source=");
+        try quoted(writer, source.file, .text);
+        try writer.print(":{d}:{d}", .{ source.line, source.column });
+    }
+    for (event.fields) |field| {
+        try writer.writeByte(' ');
+        try quoted(writer, field.key, .text);
+        try writer.writeByte('=');
+        try valueInner(writer, field.value, .text);
+    }
+    try writer.writeByte('\n');
+}
+
+fn encodeLogfmt(event: Event, writer: *std.Io.Writer) std.Io.Writer.Error!void {
+    try writer.print("timestamp_ns={d} severity={s} scope=", .{ event.timestamp_ns, @tagName(event.level) });
+    try quoted(writer, event.scope, .text);
+    try writer.writeAll(" message=");
+    try message(writer, event, .text);
+    try writer.print(" session={d} channel={d} sequence={d} route_mask={d} config_generation={d} trace_flags={d}", .{ event.session, event.channel, event.sequence, event.route_mask, event.config_generation, event.trace_flags });
+    if (event.trace_id) |id| {
+        try writer.writeAll(" trace_id=");
+        try hex(writer, &id);
+    }
+    if (event.span_id) |id| {
+        try writer.writeAll(" span_id=");
+        try hex(writer, &id);
+    }
+    if (event.source) |source| {
+        try writer.writeAll(" source.file=");
+        try quoted(writer, source.file, .text);
+        try writer.print(" source.line={d} source.column={d}", .{ source.line, source.column });
+    }
+    for (event.fields) |field| {
+        try writer.writeAll(" attr.");
+        try logfmtKey(writer, field.key);
+        try writer.writeByte('=');
+        if (field.value == .array or field.value == .group) {
+            // A nested representation is one quoted logfmt value, including
+            // embedded spaces, quotes and all escaped record separators.
+            var output = try QuotedWriter.init(writer, .text);
+            try valueInner(&output.interface, field.value, .text);
+            try output.finish();
+        } else try valueInner(writer, field.value, .text);
+    }
+    try writer.writeByte('\n');
+}
