+inline fn reduce128(input: V2) u32 {
+    var x1 = input;
+    const t = clmul(x1, k3k4, 0x10);
+    x1 = shiftRight8(x1) ^ t;
+    const low = shiftRight4(x1);
+    x1 &= mask;
+    x1 = clmul(x1, k5k0, 0x00) ^ low;
+    const b1 = clmul(x1 & mask, poly, 0x10);
+    const b2 = clmul(b1 & mask, poly, 0x00);
+    x1 ^= b2;
+    return @truncate(x1[0] >> 32);
+}
+
+/// Updates the reflected register state for exactly 16, 32 or 48 bytes.
+/// Each load belongs to the supplied input; no padding or four-lane preload
+/// is needed. The caller applies the final bitwise NOT as usual.
+pub fn updateShort(state: u32, bytes: []const u8) u32 {
+    std.debug.assert(bytes.len >= 16 and bytes.len < 64 and bytes.len % 16 == 0);
+    var x1 = load16(bytes.ptr) ^ V2{ @as(u64, state), 0 };
+    var offset: usize = 16;
+    while (offset < bytes.len) : (offset += 16) {
+        const x2 = load16(bytes.ptr + offset);
+        const x5 = clmul(x1, k3k4, 0x00);
+        x1 = clmul(x1, k3k4, 0x11) ^ x2 ^ x5;
+    }
+    return reduce128(x1);
+}
