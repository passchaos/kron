+test "short CRC folding preserves every message and seed basis bit for 16 32 and 48 bytes" {
+    var bytes: [48]u8 = undefined;
+    for ([_]usize{ 16, 32, 48 }) |length| {
+        for (0..length * 8) |bit| {
+            @memset(&bytes, 0);
+            bytes[bit / 8] = @as(u8, 1) << @intCast(bit % 8);
+            const input = bytes[0..length];
+            var oracle: std.hash.Crc32 = .{ .crc = 0 };
+            oracle.update(input);
+            const actual = updateShort(0, input);
+            try std.testing.expectEqual(bitwiseState(0, input), actual);
+            try std.testing.expectEqual(~oracle.final(), actual);
+        }
+        @memset(&bytes, 0);
+        for (0..32) |bit| {
+            const state = @as(u32, 1) << @intCast(bit);
+            const input = bytes[0..length];
+            var oracle: std.hash.Crc32 = .{ .crc = state };
+            oracle.update(input);
+            const actual = updateShort(state, input);
+            try std.testing.expectEqual(bitwiseState(state, input), actual);
+            try std.testing.expectEqual(~oracle.final(), actual);
+        }
+    }
+}
