+test "short CRC folding preserves arbitrary seeds and all 32 input alignments" {
+    var bytes: [48 + 31]u8 = undefined;
+    var random = std.Random.DefaultPrng.init(0x73686f7274637263);
+    random.random().bytes(&bytes);
+    for (0..32) |alignment| for ([_]usize{ 16, 32, 48 }) |length| {
+        const input = bytes[alignment..][0..length];
+        const states = [_]u32{ 0, 0xffffffff, 0x12345678, random.random().int(u32) };
+        for (states) |state| {
+            var oracle: std.hash.Crc32 = .{ .crc = state };
+            oracle.update(input);
+            const actual = updateShort(state, input);
+            try std.testing.expectEqual(bitwiseState(state, input), actual);
+            try std.testing.expectEqual(~oracle.final(), actual);
+        }
+    };
+}
