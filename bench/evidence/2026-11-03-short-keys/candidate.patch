+fn keysEqual(a: []const u8, b: []const u8) bool {
+    if (a.len != b.len) return false;
+    if (a.len == 0 or a.ptr == b.ptr) return true;
+    if (a.len >= 4 and a.len <= 8) {
+        // These two reads cover the entire key and stay within each slice.
+        // Longer keys retain the standard library's vector comparison.
+        return std.mem.readInt(u32, a[0..4], .little) == std.mem.readInt(u32, b[0..4], .little) and
+            std.mem.readInt(u32, a[a.len - 4 ..][0..4], .little) == std.mem.readInt(u32, b[b.len - 4 ..][0..4], .little);
+    }
+    return std.mem.eql(u8, a, b);
+}
