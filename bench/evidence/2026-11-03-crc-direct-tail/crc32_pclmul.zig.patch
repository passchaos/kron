+
+test "direct CRC tails preserve every 20 and 24 byte message and seed basis bit" {
+    var bytes: [24]u8 = undefined;
+    inline for (.{ 20, 24 }) |length| {
+        for (0..length * 8) |bit| {
+            @memset(&bytes, 0);
+            bytes[bit / 8] = @as(u8, 1) << @intCast(bit % 8);
+            const input = bytes[0..length];
+            const actual = if (length == 20) update20(0, input) else update24(0, input);
+            var oracle: std.hash.Crc32 = .{ .crc = 0 };
+            oracle.update(input);
+            try std.testing.expectEqual(bitwiseState(0, input), actual);
+            try std.testing.expectEqual(~oracle.final(), actual);
+        }
+        @memset(&bytes, 0);
+        for (0..32) |bit| {
+            const state = @as(u32, 1) << @intCast(bit);
+            const input = bytes[0..length];
+            const actual = if (length == 20) update20(state, input) else update24(state, input);
+            var oracle: std.hash.Crc32 = .{ .crc = state };
+            oracle.update(input);
+            try std.testing.expectEqual(bitwiseState(state, input), actual);
+            try std.testing.expectEqual(~oracle.final(), actual);
+        }
+    }
+}
