+// The original four-multiply reduction is copied for the exact-tail owners.
+// The existing block update retains its literal reduction and code boundary.
+inline fn reduceTail(input: V2) u32 {
+    var x1 = input;
+    const t = clmul(x1, k3k4, 0x10);
+    x1 = shiftRight8(x1) ^ t;
+    const low = shiftRight4(x1);
+    x1 &= mask;
+    x1 = clmul(x1, k5k0, 0x00) ^ low;
+    const b1 = clmul(x1 & mask, poly, 0x10);
+    const b2 = clmul(b1 & mask, poly, 0x00);
+    x1 ^= b2;
+    return @truncate(x1[0] >> 32);
+}
+
+/// Returns the raw reflected state after exactly 20 bytes, without final XOR.
+/// The 16-byte load and the four-byte tail load stay within the supplied slice.
+pub inline fn update20(state: u32, bytes: []const u8) u32 {
+    std.debug.assert(bytes.len == 20);
+    const value = load16(bytes.ptr) ^ V2{ @as(u64, state), 0 };
+    const tail = std.mem.readInt(u32, bytes[16..][0..4], .little);
+    const product = clmul(value, k5k0, 0x00);
+    const combined = product ^ V2{ value[1] << 32, (value[1] >> 32) ^ (@as(u64, tail) << 32) };
+    return reduceTail(combined);
+}
+
+/// Returns the raw reflected state after exactly 24 bytes, without final XOR.
+/// The 16-byte load and the eight-byte tail load stay within the supplied slice.
+pub inline fn update24(state: u32, bytes: []const u8) u32 {
+    std.debug.assert(bytes.len == 24);
+    const value = load16(bytes.ptr) ^ V2{ @as(u64, state), 0 };
+    const tail = std.mem.readInt(u64, bytes[16..][0..8], .little);
+    const combined = clmul(value, k64, 0x00) ^ clmul(value, k64, 0x11) ^ V2{ 0, tail };
+    return reduceTail(combined);
+}
