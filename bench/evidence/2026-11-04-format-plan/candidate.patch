+
+/// Shape-enforcing owner: the caller's `Fields` type is the compile-time
+/// contract, so the prepared render plan needs no per-record shape check.
+pub fn FormatOwner(comptime R: type, comptime Fields: type) type {
+    return struct {
+        const Self = @This();
+        pub const value_owner = true;
+        pub const field_names = std.meta.fieldNames(Fields);
+        runtime: *R,
+        binding: Binding,
+
+        pub fn enabled(self: Self, level: logger.Level, scope: []const u8) bool {
+            return self.runtime.enabled(level, scope);
+        }
+
+        pub fn begin(self: Self, level: logger.Level, scope: []const u8) logger.BeginResult {
+            return self.runtime.begin(level, scope);
+        }
+
+        pub fn end(self: Self) void {
+            self.runtime.end();
+        }
+
+        pub fn nowNs(self: Self) i64 {
+            return self.runtime.nowNs();
+        }
+
+        pub fn submit(self: Self, admission: logger.Admission, event: logger.Event) anyerror!logger.EmitResult {
+            const definition = self.binding.definition;
+            const message = definition.message orelse return error.MissingPreparedMessage;
+            const plan = common.RenderPlan{ .keys = field_names, .scope = definition.scope, .message = message };
+            return self.runtime.submitWithFormat(admission, event, self.binding, &plan);
+        }
+
+        pub fn captureFailed(self: Self, err: anyerror) void {
+            self.runtime.captureFailed(err);
+        }
+
+        pub fn reportError(self: Self, err: anyerror) void {
+            self.runtime.reportError(err);
+        }
+    };
+}
+
+pub fn FormatLogger(comptime R: type, comptime Fields: type) type {
+    return struct {
+        frontend: logger.Logger(FormatOwner(R, Fields), .trace),
+        message: []const u8,
+
+        pub fn emit(self: *const @This(), level: logger.Level, fields: Fields) !logger.EmitResult {
+            return self.frontend.tryEmit(level, self.message, fields);
+        }
+
+        /// Generic-frontend compatibility: the message is fixed by the
+        /// prepared binding, so callers of the shared worker loop can pass it
+        /// and are ignored only after the compile-time Fields contract holds.
+        pub fn tryEmit(self: *const @This(), level: logger.Level, message: []const u8, fields: Fields) !logger.EmitResult {
+            _ = message;
+            return self.emit(level, fields);
+        }
+    };
+}
