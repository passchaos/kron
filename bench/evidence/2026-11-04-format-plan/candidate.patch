+const PlanShape = struct { a: u64, b: u64 };
+
+fn formatPlanRun(allocator: std.mem.Allocator, use_plan: bool) ![]u8 {
+    var bytes: [8192]u8 = undefined;
+    var sink = MemorySink.initBuffer(&bytes);
+    const runtime = try Runtime.create(allocator, std.testing.io, .{
+        .submission = .asynchronous,
+        .memory_queue = .{ .capacity = 8, .max_record_bytes = 1024, .schema_capacity = 2, .max_schema_bytes = 1024, .verify_crc = false, .text_format = true },
+        .routes = &.{.{ .name = "out", .sink = sink.sink(), .format = .json }},
+        .clock = Clock.zeroTimestamp(),
+    });
+    defer runtime.destroy();
+    runtime.session = 42;
+    if (use_plan) {
+        const binding = try runtime.prewarmFormat("cache", null, "schema", struct {}, PlanShape);
+        const log = try runtime.loggerWithFormat(PlanShape, binding);
+        _ = try log.emit(.info, .{ .a = @as(u64, 1), .b = @as(u64, 2) });
+    } else {
+        const event: Event = .{ .level = .info, .scope = "cache", .message = "schema", .timestamp_ns = 0, .fields = &.{ field.kv("a", @as(u64, 1)), field.kv("b", @as(u64, 2)) } };
+        const binding = try runtime.prewarmSchema(event);
+        const log = try runtime.loggerWithSchema(binding);
+        _ = try log.tryEmit(.info, "schema", .{ .a = @as(u64, 1), .b = @as(u64, 2) });
+    }
+    try runtime.flush(.written);
+    try runtime.shutdown(.drain);
+    return allocator.dupe(u8, sink.written());
+}
+
+test "shape-enforcing prepared logger matches generic schema output" {
+    const planned = try formatPlanRun(std.testing.allocator, true);
+    defer std.testing.allocator.free(planned);
+    const generic = try formatPlanRun(std.testing.allocator, false);
+    defer std.testing.allocator.free(generic);
+    try std.testing.expectEqualStrings(generic, planned);
+}
