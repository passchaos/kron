+inline fn fixedWord(comptime top_row: usize, word: u32) u32 {
+    const a: *const [256]u32 = if (top_row < 16) &tables[top_row] else &extra[top_row - 16];
+    const b: *const [256]u32 = if (top_row - 1 < 16) &tables[top_row - 1] else &extra[top_row - 17];
+    const c: *const [256]u32 = if (top_row - 2 < 16) &tables[top_row - 2] else &extra[top_row - 18];
+    const d: *const [256]u32 = if (top_row - 3 < 16) &tables[top_row - 3] else &extra[top_row - 19];
+    return (a[word & 255] ^ b[(word >> 8) & 255]) ^ (c[(word >> 16) & 255] ^ d[word >> 24]);
+}
 
