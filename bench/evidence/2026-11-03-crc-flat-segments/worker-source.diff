+    /// Folds a complete fixed journal segment using byte-distance rows.
+    /// Every input word is read before the single final state write, including
+    /// when the destination state aliases bytes within the supplied segment.
+    pub fn updateFixed(self: *Crc32, comptime N: usize, bytes: *const [N]u8) void {
+        if (N != 20 and N != 24) @compileError("fixed CRC segments must contain 20 or 24 bytes");
+        const a = fixedWord(N - 1, std.mem.readInt(u32, bytes[0..4], .little) ^ self.state);
+        const b = fixedWord(N - 5, std.mem.readInt(u32, bytes[4..8], .little));
+        const c = fixedWord(N - 9, std.mem.readInt(u32, bytes[8..12], .little));
+        const d = fixedWord(N - 13, std.mem.readInt(u32, bytes[12..16], .little));
+        const e = fixedWord(N - 17, std.mem.readInt(u32, bytes[16..20], .little));
+        const folded = if (N == 20) (a ^ b) ^ (c ^ (d ^ e)) else blk: {
+            const f = fixedWord(N - 21, std.mem.readInt(u32, bytes[20..24], .little));
+            break :blk (a ^ b) ^ ((c ^ d) ^ (e ^ f));
+        };
+        self.state = folded;
+    }
