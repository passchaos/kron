+fn bitwiseState(initial: u32, bytes: []const u8) u32 {
+    var state = initial;
+    for (bytes) |byte| {
+        state ^= byte;
+        for (0..8) |_| state = (state >> 1) ^ (if (state & 1 != 0) @as(u32, 0xedb88320) else 0);
+    }
+    return state;
+}
