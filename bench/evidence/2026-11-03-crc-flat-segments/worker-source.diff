+fn normalGeneratorRow(byte: u8, row: usize) u32 {
+    // Start in the normal polynomial domain and reflect only at the endpoints.
+    // This does not use any candidate table or reflected transition helper.
+    var remainder: u64 = @bitReverse(@as(u32, byte));
+    for (0..8 * (row + 1)) |_| {
+        remainder <<= 1;
+        if (remainder & (@as(u64, 1) << 32) != 0) remainder ^= 0x104c11db7;
+    }
+    return @bitReverse(@as(u32, @intCast(remainder)));
+}
