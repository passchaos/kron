+        error.WriteFailed => return error.EncodedRecordTooLarge,
+        else => return err,
+    };
+    route.sink.writeRecord(bytes) catch |err| {
+        diagnostics.note(err, .write);
+        if (route.delivery == .required) return err;
+    };
+    return true;
+}
