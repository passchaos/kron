+pub const max_render_plan_fields = 64;
+
+/// Prepared JSON renderer for a validated flat schema shape. Keys and the
+/// scope/message are known safe ASCII, so the hot path skips key escaping and
+/// generic member dispatch. Any shape mismatch falls back to the generic
+/// renderer; the prepared output is byte-identical to `encodeJson`.
+pub const RenderPlan = struct {
+    keys: [max_render_plan_fields][]const u8,
+    count: usize,
+    scope: []const u8,
+    message: ?[]const u8,
+
+    pub fn build(definition: schema.Definition) !?RenderPlan {
+        if (definition.message_template or definition.argument_count != 0 or definition.source != null) return null;
+        if (!jsonSafe(definition.scope)) return null;
+        if (definition.message) |message_text| if (!jsonSafe(message_text)) return null;
+        var plan: RenderPlan = .{ .keys = undefined, .count = 0, .scope = definition.scope, .message = definition.message };
+        var iterator = definition.fields();
+        while (try iterator.next()) |field| {
+            if (plan.count == max_render_plan_fields or !jsonSafe(field.key)) return null;
+            plan.keys[plan.count] = field.key;
+            plan.count += 1;
+        }
+        return plan;
+    }
+
+    pub fn matches(self: *const RenderPlan, event: Event) bool {
+        if (!std.mem.eql(u8, event.scope, self.scope)) return false;
+        if (self.message) |message_text| {
+            if (!std.mem.eql(u8, event.message, message_text)) return false;
+        } else if (!jsonSafe(event.message)) return false;
+        if (event.message_template or event.format_args.len != 0 or event.source != null or event.trace_id != null or event.span_id != null) return false;
+        if (event.fields.len != self.count) return false;
+        for (event.fields, 0..) |field, index| {
+            if (!std.mem.eql(u8, field.key, self.keys[index])) return false;
+        }
+        return true;
+    }
+
+    pub fn render(self: *const RenderPlan, event: Event, writer: *std.Io.Writer) std.Io.Writer.Error!void {
+        const message_text = self.message orelse event.message;
+        try writer.writeAll("{\"timestamp_ns\":");
+        try writeTaggedValue(writer, .timestamp_ns, event.timestamp_ns, .json);
+        try writer.writeAll(jsonSeverityField(event.level));
+        try writer.writeAll(",\"scope\":\"");
+        try writer.writeAll(self.scope);
+        try writer.writeAll("\",\"message\":\"");
+        try writer.writeAll(message_text);
+        try writer.writeAll("\",\"session\":");
+        try writeTaggedValue(writer, .unsigned, event.session, .json);
+        try writer.writeAll(",\"channel\":");
+        try decimal.write(writer, event.channel);
+        try writer.writeAll(",\"sequence\":");
+        try writeTaggedValue(writer, .unsigned, event.sequence, .json);
+        try writer.writeAll(",\"route_mask\":");
+        try writeTaggedValue(writer, .unsigned, event.route_mask, .json);
+        try writer.writeAll(",\"config_generation\":");
+        try writeTaggedValue(writer, .unsigned, event.config_generation, .json);
+        try writer.writeAll(",\"trace_flags\":");
+        try decimal.write(writer, event.trace_flags);
+        try writer.writeAll(",\"attributes\":{");
+        for (event.fields, 0..) |field, index| {
+            if (index != 0) try writer.writeByte(',');
+            try writer.writeByte('"');
+            try writer.writeAll(self.keys[index]);
+            try writer.writeAll("\":");
+            try valueInner(writer, field.value, .json);
+        }
+        try writer.writeAll("}}\n");
+    }
+};
+
+fn jsonSafe(bytes: []const u8) bool {
+    for (bytes) |byte| {
+        if (byte < 0x20 or byte > 0x7e or byte == '"' or byte == '\\') return false;
+    }
+    return true;
+}
