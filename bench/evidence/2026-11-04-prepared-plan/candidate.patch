+test "prepared render plan builds only for safe flat shapes" {
+    var bytes: [8192]u8 = undefined;
+    var sink = MemorySink.initBuffer(&bytes);
+    const runtime = try Runtime.create(std.testing.allocator, std.testing.io, .{
+        .submission = .asynchronous,
+        .memory_queue = .{ .capacity = 8, .max_record_bytes = 1024, .schema_capacity = 2, .max_schema_bytes = 1024, .verify_crc = false, .text_format = true },
+        .routes = &.{.{ .name = "out", .sink = sink.sink(), .format = .json }},
+        .clock = Clock.zeroTimestamp(),
+    });
+    defer runtime.destroy();
+    const safe: Event = .{ .level = .info, .scope = "cache", .message = "schema", .timestamp_ns = 0, .fields = &.{ field.kv("a", @as(u64, 1)), field.kv("b", @as(u64, 2)) } };
+    const binding = try runtime.prewarmSchema(safe);
+    try std.testing.expect(binding.plan != null);
+    if (binding.plan) |plan| try std.testing.expect(plan.matches(safe));
+    const unsafe: Event = .{ .level = .info, .scope = "cache", .message = "bad\"message", .timestamp_ns = 0, .fields = &.{field.kv("a", @as(u64, 1))} };
+    const unsafe_binding = try runtime.prewarmSchema(unsafe);
+    if (unsafe_binding.plan) |plan| {
+        try std.testing.expect(!plan.matches(unsafe));
+    } else return error.MissingRenderPlan;
+}
