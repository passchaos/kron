+/// Sharded producer-side admission counters. Each thread increments a
+/// cache-line-separated word that carries its own closing/cut flags, so a
+/// begin/end pair never touches a word shared with another producer. Close
+/// and cut publish a global flag first, then set the flags on every shard and
+/// wait for the summed counters to drain.
+pub const shard_count = 8;
+pub const ShardCounter = struct {
+    word: Atomic(u64) align(64) = .init(0),
+};
+pub const Sharded = struct {
+    /// Fast guard for `enabled`/close checks; authoritative admission state is
+    /// the per-shard word ordered with the producer's CAS.
+    flags: Atomic(u64) = .init(0),
+    counters: [shard_count]ShardCounter = @splat(.{}),
+};
+
+threadlocal var shard_index: usize = 0;
+threadlocal var shard_assigned: bool = false;
+var next_shard: Atomic(usize) = .init(0);
+
+fn currentShard() usize {
+    if (!shard_assigned) {
+        shard_index = next_shard.fetchAdd(1, .monotonic) % shard_count;
+        shard_assigned = true;
+    }
+    return shard_index;
+}
+
+pub fn activeSharded(sharded: *const Sharded) u64 {
+    var total: u64 = 0;
+    for (sharded.counters) |counter| total += counter.word.load(.acquire) & count_mask;
+    return total;
+}
+
+pub fn closingSharded(sharded: *const Sharded) bool {
+    return sharded.flags.load(.acquire) & closing_bit != 0;
+}
+
+pub fn setShardedFlag(sharded: *Sharded, bit: u64) void {
+    _ = sharded.flags.fetchOr(bit, .acq_rel);
+    for (&sharded.counters) |*counter| _ = counter.word.fetchOr(bit, .acq_rel);
+}
+
+pub fn clearShardedFlag(sharded: *Sharded, bit: u64) void {
+    for (&sharded.counters) |*counter| _ = counter.word.fetchAnd(~bit, .release);
+    _ = sharded.flags.fetchAnd(~bit, .release);
+}
+
+pub fn acquireSharded(sharded: *Sharded, epoch: *Atomic(u32), io: std.Io) ?usize {
+    const shard = currentShard();
+    while (true) {
+        const observed = sharded.counters[shard].word.load(.acquire);
+        if (observed & closing_bit != 0) return null;
+        if (observed & cut_bit != 0) {
+            const version = epoch.load(.acquire);
+            const current = sharded.counters[shard].word.load(.acquire);
+            if (current & cut_bit != 0 and current & closing_bit == 0) io.futexWaitUncancelable(u32, &epoch.raw, version);
+            continue;
+        }
+        if (observed & count_mask == count_mask) return null;
+        if (sharded.counters[shard].word.cmpxchgWeak(observed, observed + 1, .acq_rel, .acquire)) |_| {} else return shard;
+    }
+}
+
+/// Returns true when this release observed the closing bit after draining its
+/// shard, so the caller can notify the closing collector.
+pub fn releaseSharded(sharded: *Sharded, shard: usize, epoch: *Atomic(u32), io: std.Io) bool {
+    const previous = sharded.counters[shard].word.fetchSub(1, .acq_rel);
+    std.debug.assert(previous & count_mask != 0);
+    if (previous & count_mask != 1 or previous & (closing_bit | cut_bit) == 0) return false;
+    wake(epoch, io);
+    return previous & closing_bit != 0;
+}
+
+pub fn waitSharded(sharded: *const Sharded, epoch: *Atomic(u32), io: std.Io) void {
+    while (true) {
+        const version = epoch.load(.acquire);
+        if (activeSharded(sharded) == 0) return;
+        io.futexWaitUncancelable(u32, &epoch.raw, version);
+    }
+}
