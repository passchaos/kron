diff --git a/src/config/tests/uniform_filter.zig b/src/config/tests/uniform_filter.zig
new file mode 100644
index 0000000..4decc9d
--- /dev/null
+++ b/src/config/tests/uniform_filter.zig
@@ -0,0 +1,85 @@
+//! Uniform atomic mirrors and scoped snapshot reads must remain equivalent.
+const std = @import("std");
+const reload = @import("../reload.zig");
+const Filter = @import("../filter.zig").Filter;
+const Level = @import("../../core/level.zig").Level;
+const Atomic = std.atomic.Value;
+
+test "uniform filter atomics preserve default level binding and scoped fallback without allocations" {
+    var allocator = std.testing.FailingAllocator.init(std.testing.allocator, .{});
+    const filter = try reload.DynamicFilter.createBound(allocator.allocator(), std.testing.io, "info", 7);
+    defer filter.destroy();
+    allocator.fail_index = allocator.alloc_index;
+    const decision_fn: *const fn (*reload.DynamicFilter, []const u8) reload.BoundDecision = &reload.DynamicFilter.boundDecision;
+    try std.testing.expectEqual(Level.info, decision_fn(filter, "function.pointer").decision.level);
+    const before = reload.TestingAudit.reader_rmw.load(.monotonic);
+    for (0..100) |_| {
+        const decision = filter.boundDecision("any.scope");
+        try std.testing.expectEqual(Level.info, decision.decision.level);
+        try std.testing.expectEqual(@as(u64, 1), decision.decision.generation);
+        try std.testing.expectEqual(@as(u64, 7), decision.configuration_generation);
+    }
+    try std.testing.expectEqual(before, reload.TestingAudit.reader_rmw.load(.monotonic));
+    filter.publishBound(try Filter.parse("warn,http=trace"), 9);
+    try std.testing.expectEqual(Level.trace, filter.boundDecision("http.client").decision.level);
+    try std.testing.expectEqual(Level.warn, filter.boundDecision("httpx").decision.level);
+    try std.testing.expectEqual(@as(u64, 9), filter.boundDecision("http").configuration_generation);
+    try std.testing.expectEqual(before + 6, reload.TestingAudit.reader_rmw.load(.monotonic));
+    filter.publishBound(try Filter.parse("off"), 10);
+    const uniform = filter.boundDecision("http");
+    try std.testing.expectEqual(Level.off, uniform.decision.level);
+    try std.testing.expectEqual(@as(u64, 3), uniform.decision.generation);
+    try std.testing.expectEqual(@as(u64, 10), uniform.configuration_generation);
+    try std.testing.expect(!allocator.has_induced_failure);
+}
+
+test "uniform filter atomics retain full generations and disable before wrap" {
+    const filter = try reload.DynamicFilter.create(std.testing.allocator, std.testing.io, "trace");
+    defer filter.destroy();
+    _ = filter.boundDecision("scope");
+    filter.published.store(std.math.maxInt(u56), .seq_cst);
+    try filter.reload("off");
+    try std.testing.expect(filter.uniform_disabled.load(.seq_cst));
+    try std.testing.expectEqual(std.math.maxInt(u56) + 1, filter.boundDecision("scope").decision.generation);
+    filter.published.store(0, .seq_cst);
+    try filter.reload("off");
+    try std.testing.expectEqual(@as(u64, 1), filter.boundDecision("scope").decision.generation);
+    try std.testing.expectEqual(Level.off, filter.boundDecision("scope").decision.level);
+}
+
+test "uniform filter atomic copies stay coherent during uniform and scoped slot reuse" {
+    if (@import("builtin").single_threaded) return error.SkipZigTest;
+    const Context = struct {
+        filter: *reload.DynamicFilter,
+        stop: Atomic(bool) = .init(false),
+        bad: Atomic(bool) = .init(false),
+        observations: Atomic(u64) = .init(0),
+        fn read(self: *@This()) void {
+            while (!self.stop.load(.acquire)) {
+                const value = self.filter.boundDecision("http.client");
+                const expected: Level = if (value.decision.generation & 1 == 1) .debug else .warn;
+                if (value.decision.level != expected or value.configuration_generation != value.decision.generation + 100) self.bad.store(true, .release);
+                _ = self.observations.fetchAdd(1, .monotonic);
+            }
+        }
+    };
+    const filter = try reload.DynamicFilter.createBound(std.testing.allocator, std.testing.io, "debug", 101);
+    defer filter.destroy();
+    var context: Context = .{ .filter = filter };
+    var readers: [4]std.Thread = undefined;
+    var started: usize = 0;
+    defer {
+        context.stop.store(true, .release);
+        for (readers[0..started]) |reader| reader.join();
+    }
+    for (&readers) |*reader| {
+        reader.* = try std.Thread.spawn(.{}, Context.read, .{&context});
+        started += 1;
+    }
+    while (context.observations.load(.monotonic) < 4) std.atomic.spinLoopHint();
+    for (0..2000) |index| filter.publishBound(try Filter.parse(if (index & 1 == 0) "err,http=warn" else "debug"), index + 102);
+    context.stop.store(true, .release);
+    for (readers) |reader| reader.join();
+    started = 0;
+    try std.testing.expect(!context.bad.load(.acquire));
+}
