+//! Public wall-clock dispatch, ownership, and producer timestamp boundaries.
+const std = @import("std");
+const kron = @import("kron");
+const testing = std.testing;
+const WallCallback = @FieldType(kron.Clock, "real_now");
+
+const WallCase = struct { input: i96, expected: i64 };
+// Literal outcomes are independent of the implementation's clamp expression.
+const wall_cases = [_]WallCase{
+    .{ .input = std.math.minInt(i96), .expected = std.math.minInt(i64) },
+    .{ .input = @as(i96, std.math.minInt(i64)) - 1, .expected = std.math.minInt(i64) },
+    .{ .input = std.math.minInt(i64), .expected = std.math.minInt(i64) },
+    .{ .input = @as(i96, std.math.minInt(i64)) + 1, .expected = std.math.minInt(i64) + 1 },
+    .{ .input = -1_700_000_000_123_456_789, .expected = -1_700_000_000_123_456_789 },
+    .{ .input = -1, .expected = -1 },
+    .{ .input = 0, .expected = 0 },
+    .{ .input = 1, .expected = 1 },
+    .{ .input = 123_456_789, .expected = 123_456_789 },
+    .{ .input = 1_700_000_000_123_456_789, .expected = 1_700_000_000_123_456_789 },
+    .{ .input = @as(i96, std.math.maxInt(i64)) - 1, .expected = std.math.maxInt(i64) - 1 },
+    .{ .input = std.math.maxInt(i64), .expected = std.math.maxInt(i64) },
+    .{ .input = @as(i96, std.math.maxInt(i64)) + 1, .expected = std.math.maxInt(i64) },
+    .{ .input = std.math.maxInt(i96), .expected = std.math.maxInt(i64) },
+};
+
+const FakeIo = struct {
+    wall: i96 = 0,
+    awake: i96 = 0,
+    a_wall_calls: usize = 0,
+    b_wall_calls: usize = 0,
+    awake_calls: usize = 0,
+    last_userdata: ?*anyopaque = null,
+    switch_clock: ?*kron.Clock = null,
+    replacement: ?WallCallback = null,
+
+    fn now(raw: ?*anyopaque, which: std.Io.Clock, from_b: bool) std.Io.Timestamp {
+        const self: *@This() = @ptrCast(@alignCast(raw.?));
+        self.last_userdata = raw;
+        return .{ .nanoseconds = switch (which) {
+            .real => blk: {
+                if (from_b) self.b_wall_calls += 1 else self.a_wall_calls += 1;
+                if (self.switch_clock) |clock| {
+                    clock.real_now = self.replacement.?;
+                    self.switch_clock = null;
+                }
+                break :blk self.wall;
+            },
+            .awake => blk: {
+                self.awake_calls += 1;
+                break :blk self.awake;
+            },
+            else => unreachable,
+        } };
+    }
+
+    fn nowA(raw: ?*anyopaque, which: std.Io.Clock) std.Io.Timestamp {
+        return now(raw, which, false);
+    }
+
+    fn nowB(raw: ?*anyopaque, which: std.Io.Clock) std.Io.Timestamp {
+        return now(raw, which, true);
+    }
+
+    fn io(self: *@This(), vtable: *std.Io.VTable, comptime from_b: bool) std.Io {
+        vtable.* = testing.io.vtable.*;
+        vtable.now = if (from_b) nowB else nowA;
+        // This FakeIo is used ONLY for Clock calls or temporarily for pure
+        // Runtime.nowNs. Other cloned vtable entries expect real Io userdata.
+        return .{ .userdata = self, .vtable = vtable };
+    }
+};
+
+const SwitchingClock = struct {
+    clock: ?*kron.Clock = null,
+    next: ?WallCallback = null,
+    wall: i64 = 202,
+    monotonic: u64 = 77,
+    a_calls: usize = 0,
+    b_calls: usize = 0,
+    monotonic_calls: usize = 0,
+    seen_userdata: ?*anyopaque = null,
+    seen_vtable: ?*const std.Io.VTable = null,
+
+    fn realA(raw: ?*anyopaque, io: std.Io) i64 {
+        const self: *@This() = @ptrCast(@alignCast(raw.?));
+        self.a_calls += 1;
+        self.seen_userdata = io.userdata;
+        self.seen_vtable = io.vtable;
+        if (self.next) |callback| {
+            self.clock.?.real_now = callback;
+            self.next = null;
+        }
+        return self.wall;
+    }
+
+    fn realB(raw: ?*anyopaque, io: std.Io) i64 {
+        const self: *@This() = @ptrCast(@alignCast(raw.?));
+        self.b_calls += 1;
+        self.seen_userdata = io.userdata;
+        self.seen_vtable = io.vtable;
+        return -303;
+    }
+
+    fn monotonicNow(raw: ?*anyopaque, io: std.Io) u64 {
+        const self: *@This() = @ptrCast(@alignCast(raw.?));
+        self.monotonic_calls += 1;
+        self.seen_userdata = io.userdata;
+        self.seen_vtable = io.vtable;
+        return self.monotonic;
+    }
+};
+
+test "clock dispatch: default and now alias clamp every i96 boundary using the supplied Io identity" {
+    var fake: FakeIo = .{};
+    var ignored_context: FakeIo = .{ .wall = 999 };
+    var vtable_a: std.Io.VTable = undefined;
+    var vtable_b: std.Io.VTable = undefined;
+    const io_a = fake.io(&vtable_a, false);
+    const io_b = fake.io(&vtable_b, true);
+    const clock: kron.Clock = .{ .context = &ignored_context };
+    for (wall_cases) |case| {
+        fake.wall = case.input;
+        try testing.expectEqual(case.expected, clock.realNow(io_a));
+        try testing.expectEqual(case.expected, clock.now(io_a));
+        try testing.expectEqual(case.expected, clock.realNow(io_b));
+    }
+    try testing.expectEqual(@as(usize, wall_cases.len * 2), fake.a_wall_calls);
+    try testing.expectEqual(@as(usize, wall_cases.len), fake.b_wall_calls);
+    try testing.expectEqual(@as(?*anyopaque, &fake), fake.last_userdata);
+    try testing.expectEqual(@as(usize, 0), fake.awake_calls);
+    try testing.expectEqual(@as(usize, 0), ignored_context.a_wall_calls);
+    try testing.expectEqual(@as(usize, 0), ignored_context.b_wall_calls);
+}
+
+test "clock dispatch: the same object honors callback switches and finishes its already selected callback" {
+    var fake: FakeIo = .{ .wall = 101 };
+    var vtable: std.Io.VTable = undefined;
+    const io = fake.io(&vtable, false);
+    var clock: kron.Clock = .{};
+    const default_callback = clock.real_now;
+    var custom: SwitchingClock = .{ .clock = &clock };
+    clock.context = &custom;
+    try testing.expectEqual(@as(i64, 101), clock.realNow(io));
+    clock.real_now = SwitchingClock.realA;
+    custom.next = SwitchingClock.realB;
+    try testing.expectEqual(@as(i64, 202), clock.now(io));
+    try testing.expectEqual(@as(usize, 1), custom.a_calls);
+    try testing.expectEqual(@as(usize, 0), custom.b_calls);
+    try testing.expectEqual(@as(i64, -303), clock.realNow(io));
+    clock.real_now = default_callback;
+    fake.wall = 404;
+    try testing.expectEqual(@as(i64, 404), clock.now(io));
+    clock.real_now = SwitchingClock.realA;
+    custom.next = default_callback;
+    custom.wall = 505;
+    try testing.expectEqual(@as(i64, 505), clock.realNow(io));
+    fake.wall = 606;
+    try testing.expectEqual(@as(i64, 606), clock.now(io));
+    try testing.expectEqual(@as(usize, 3), fake.a_wall_calls);
+    try testing.expectEqual(@as(usize, 2), custom.a_calls);
+    try testing.expectEqual(@as(usize, 1), custom.b_calls);
+    try testing.expectEqual(io.userdata, custom.seen_userdata);
+    try testing.expectEqual(@as(?*const std.Io.VTable, io.vtable), custom.seen_vtable);
+}
+
+test "clock dispatch: default Io now may switch the owner callback for the next call" {
+    var clock: kron.Clock = .{};
+    var custom: SwitchingClock = .{ .wall = 818 };
+    clock.context = &custom;
+    var fake: FakeIo = .{ .wall = 717, .switch_clock = &clock, .replacement = SwitchingClock.realA };
+    var vtable: std.Io.VTable = undefined;
+    const io = fake.io(&vtable, false);
+    try testing.expectEqual(@as(i64, 717), clock.realNow(io));
+    try testing.expectEqual(@as(usize, 0), custom.a_calls);
+    try testing.expectEqual(@as(i64, 818), clock.now(io));
+    try testing.expectEqual(@as(usize, 1), fake.a_wall_calls);
+    try testing.expectEqual(@as(usize, 1), custom.a_calls);
+    try testing.expectEqual(io.userdata, custom.seen_userdata);
+    try testing.expectEqual(@as(?*const std.Io.VTable, io.vtable), custom.seen_vtable);
+}
+
+test "clock dispatch: zero timestamps preserve custom monotonic callback context and default awake clamping" {
+    var fake: FakeIo = .{ .wall = 999, .awake = -1 };
+    var vtable: std.Io.VTable = undefined;
+    const io = fake.io(&vtable, false);
+    var custom: SwitchingClock = .{};
+    const injected: kron.Clock = .{ .context = &custom, .real_now = SwitchingClock.realA, .monotonic_now = SwitchingClock.monotonicNow };
+    const disabled = injected.withoutTimestamp();
+    try testing.expectEqual(injected.context, disabled.context);
+    try testing.expectEqual(injected.monotonic_now, disabled.monotonic_now);
+    for ([_]u64{ 0, 1, 77, std.math.maxInt(u64) }) |value| {
+        custom.monotonic = value;
+        try testing.expectEqual(@as(i64, 0), disabled.realNow(io));
+        try testing.expectEqual(@as(i64, 0), disabled.now(io));
+        try testing.expectEqual(value, disabled.monotonicNow(io));
+    }
+    try testing.expectEqual(@as(usize, 0), custom.a_calls);
+    try testing.expectEqual(@as(usize, 4), custom.monotonic_calls);
+    try testing.expectEqual(io.userdata, custom.seen_userdata);
+    const zero = kron.Clock.zeroTimestamp();
+    try testing.expectEqual(@as(i64, 0), zero.now(io));
+    try testing.expectEqual(@as(u64, 0), zero.monotonicNow(io));
+    fake.awake = 1_234_567_890;
+    try testing.expectEqual(@as(u64, 1_234_567_890), zero.monotonicNow(io));
+    fake.awake = std.math.maxInt(i96);
+    try testing.expectEqual(std.math.maxInt(u64), zero.monotonicNow(io));
+    try testing.expectEqual(@as(usize, 0), fake.a_wall_calls);
+    try testing.expectEqual(@as(usize, 3), fake.awake_calls);
+}
+
+test "clock dispatch: Runtime nowNs uses its current Clock and Io and restores real Io before destruction" {
+    var bytes: [2048]u8 = undefined;
+    var memory = kron.MemorySink.initBuffer(&bytes);
+    const runtime = try kron.Runtime.create(testing.allocator, testing.io, .{ .routes = &.{.{ .name = "out", .sink = memory.sink() }} });
+    defer runtime.destroy();
+    var fake: FakeIo = .{};
+    var vtable: std.Io.VTable = undefined;
+    const io = fake.io(&vtable, false);
+    const original_io = runtime.io;
+    {
+        // Runtime was created with real Io. Only pure nowNs calls may use this
+        // fake userdata; restore before any owner lifecycle/delivery method.
+        runtime.io = io;
+        defer runtime.io = original_io;
+        const original_clock = runtime.clock;
+        defer runtime.clock = original_clock;
+        for (wall_cases) |case| {
+            fake.wall = case.input;
+            try testing.expectEqual(case.expected, runtime.nowNs());
+        }
+        const default_callback = runtime.clock.real_now;
+        var custom: SwitchingClock = .{ .wall = -919 };
+        runtime.clock.context = &custom;
+        runtime.clock.real_now = SwitchingClock.realA;
+        try testing.expectEqual(@as(i64, -919), runtime.nowNs());
+        runtime.clock.real_now = default_callback;
+        fake.wall = 1_020;
+        try testing.expectEqual(@as(i64, 1_020), runtime.nowNs());
+        // Do not leave the borrowed custom context in the runtime either.
+        runtime.clock.context = null;
+        try testing.expectEqual(@as(usize, 1), custom.a_calls);
+        try testing.expectEqual(io.userdata, custom.seen_userdata);
+        try testing.expectEqual(@as(?*const std.Io.VTable, io.vtable), custom.seen_vtable);
+    }
+    try testing.expectEqual(original_io.userdata, runtime.io.userdata);
+    try testing.expectEqual(original_io.vtable, runtime.io.vtable);
+    try testing.expectEqual(@as(usize, wall_cases.len + 1), fake.a_wall_calls);
+}
+
+const ProducerClock = struct {
+    calls: usize = 0,
+    captured: usize = 0,
+    captured_at_clock: usize = 0,
+    runtime: ?*kron.Runtime = null,
+    seen_pending: usize = 0,
+    seen_target: u64 = 0,
+    seen_userdata: ?*anyopaque = null,
+
+    fn now(raw: ?*anyopaque, io: std.Io) i64 {
+        const self: *@This() = @ptrCast(@alignCast(raw.?));
+        self.calls += 1;
+        self.captured_at_clock = self.captured;
+        self.seen_userdata = io.userdata;
+        if (self.runtime) |runtime| {
+            self.seen_pending = runtime.journal.?.pending();
+            self.seen_target = runtime.journal.?.reservationTarget();
+        }
+        return @as(i64, @intCast(self.calls)) + 1_234;
+    }
+};
+
+const LazyFields = struct {
+    clock: *ProducerClock,
+    pub fn fields(self: *@This()) [1]kron.Field {
+        self.clock.captured += 1;
+        return .{kron.kv("value", @as(u64, 7))};
+    }
+};
+
+fn expectTimestampLines(bytes: []const u8, expected: []const i64) !void {
+    var lines = std.mem.tokenizeScalar(u8, bytes, '\n');
+    for (expected) |timestamp| {
+        const line = lines.next() orelse return error.MissingRecord;
+        const parsed = try std.json.parseFromSlice(std.json.Value, testing.allocator, line, .{});
+        defer parsed.deinit();
+        try testing.expectEqual(timestamp, parsed.value.object.get("timestamp_ns").?.integer);
+        try testing.expectEqual(@as(i64, 7), parsed.value.object.get("attributes").?.object.get("value").?.integer);
+    }
+    try testing.expect(lines.next() == null);
+}
+
+test "clock dispatch: Runtime filters and invalid capture skip time while full drop and fallback keep the capture boundary" {
+    inline for (.{ .drop_newest, .fallback_sync }) |overflow| {
+        var bytes: [8192]u8 = undefined;
+        var memory = kron.MemorySink.initBuffer(&bytes);
+        var clock: ProducerClock = .{};
+        const runtime = try kron.Runtime.create(testing.allocator, testing.io, .{
+            .submission = .asynchronous,
+            .memory_queue = .{ .capacity = 1, .max_record_bytes = 1024 },
+            .overflow = overflow,
+            .routes = &.{.{ .name = "out", .sink = memory.sink() }},
+            .clock = .{ .context = &clock, .real_now = ProducerClock.now },
+        });
+        defer runtime.destroy();
+        clock.runtime = runtime;
+        var gap = try runtime.journal.?.reserve();
+        defer gap.abort();
+        var provider: LazyFields = .{ .clock = &clock };
+        const log = runtime.scoped("dispatch");
+        try testing.expectEqual(kron.EmitResult.filtered, try log.tryEmitLazy(.debug, "hidden", &provider));
+        const duplicates = [_]kron.Field{ kron.kv("same", 1), kron.kv("same", 2) };
+        try testing.expectError(error.DuplicateKey, log.tryEmit(.info, "invalid", @as([]const kron.Field, &duplicates)));
+        try testing.expectEqual(@as(usize, 0), clock.calls);
+        try testing.expectEqual(@as(usize, 0), clock.captured);
+        try testing.expectEqual(if (overflow == .drop_newest) kron.EmitResult.dropped_full else kron.EmitResult.accepted, try log.tryEmitLazy(.info, "full", &provider));
+        try testing.expectEqual(@as(usize, 1), clock.calls);
+        try testing.expectEqual(@as(usize, 1), clock.captured_at_clock);
+        try testing.expectEqual(@as(usize, 1), clock.seen_pending);
+        try testing.expectEqual(@as(u64, 1), clock.seen_target);
+        try testing.expectEqual(testing.io.userdata, clock.seen_userdata);
+        try testing.expectEqual(@as(u64, 1), runtime.journal.?.reservationTarget());
+        try testing.expectEqual(@as(u64, 0), runtime.activeAdmissions());
+        gap.abort();
+        try runtime.flush(.written);
+        try testing.expectEqual(kron.EmitResult.accepted, try log.tryEmitLazy(.info, "space", &provider));
+        try runtime.flush(.written);
+        try testing.expectEqual(@as(usize, 2), clock.calls);
+        try testing.expectEqual(@as(usize, 2), clock.captured_at_clock);
+        try testing.expectEqual(@as(u64, 1), clock.seen_target);
+        try expectTimestampLines(memory.written(), if (overflow == .drop_newest) &.{1_236} else &.{ 1_235, 1_236 });
+    }
+}
+
+test "clock dispatch: Managed admission and clock tree mutation retain validation and accepted snapshots" {
+    const TreeClock = struct {
+        tree: *[1]kron.Value,
+        calls: usize = 0,
+        mutate: bool = true,
+        fn now(raw: ?*anyopaque, io: std.Io) i64 {
+            const self: *@This() = @ptrCast(@alignCast(raw.?));
+            std.debug.assert(io.userdata == testing.io.userdata);
+            self.calls += 1;
+            if (self.mutate) self.tree[0] = .{ .array = self.tree };
+            return 2_000 + @as(i64, @intCast(self.calls));
+        }
+    };
+    var bytes: [8192]u8 = undefined;
+    var writer = std.Io.Writer.fixed(&bytes);
+    var values = [_]kron.Value{.{ .unsigned = 7 }};
+    var clock: TreeClock = .{ .tree = &values };
+    const logging = try kron.Logging.create(testing.allocator, testing.io, .{ .outputs = &.{.{ .name = "out", .target = .{ .writer = &writer }, .format = .json, .mode = .asynchronous, .queue = .{ .memory = .{ .capacity = 2, .max_record_bytes = 1024 } } }} });
+    defer logging.destroy();
+    const runtime = try logging.runtime("out");
+    runtime.clock = .{ .context = &clock, .real_now = TreeClock.now };
+    var gap = try runtime.journal.?.reserve();
+    defer gap.abort();
+    const log = logging.scoped("managed.dispatch");
+    try testing.expectEqual(kron.EmitResult.filtered, try log.tryEmit(.debug, "hidden", .{}));
+    const duplicates = [_]kron.Field{ kron.kv("same", 1), kron.kv("same", 2) };
+    try testing.expectError(error.DuplicateKey, log.tryEmit(.info, "invalid", @as([]const kron.Field, &duplicates)));
+    try testing.expectEqual(@as(usize, 0), clock.calls);
+    try testing.expectError(error.CyclicValue, log.tryEmit(.info, "clock mutation", .{ .tree = kron.array(&values) }));
+    try testing.expectEqual(@as(usize, 1), clock.calls);
+    try testing.expectEqual(@as(u64, 1), runtime.journal.?.reservationTarget());
+    try testing.expectEqual(@as(u64, 0), runtime.activeAdmissions());
+    values[0] = .{ .unsigned = 7 };
+    clock.mutate = false;
+    var name = "original".*;
+    try testing.expectEqual(kron.EmitResult.accepted, try log.tryEmit(.info, "snapshot", .{ .tree = kron.array(&values), .name = @as([]const u8, &name) }));
+    @memset(&name, 'x');
+    values[0] = .{ .unsigned = 99 };
+    gap.abort();
+    try logging.flush();
+    try testing.expectEqual(@as(usize, 2), clock.calls);
+    const parsed = try std.json.parseFromSlice(std.json.Value, testing.allocator, std.mem.trim(u8, writer.buffered(), "\n"), .{});
+    defer parsed.deinit();
+    try testing.expectEqual(@as(i64, 2_002), parsed.value.object.get("timestamp_ns").?.integer);
+    const attributes = parsed.value.object.get("attributes").?.object;
+    try testing.expectEqualStrings("original", attributes.get("name").?.string);
+    try testing.expectEqual(@as(i64, 7), attributes.get("tree").?.array.items[0].integer);
+    try testing.expectEqual(@as(u64, 1), logging.health().written);
+}
+
+const RealIoObserver = struct {
+    threadlocal var active: ?*RealIoObserver = null;
+    original: std.Io,
+    wall: i96 = 0,
+    calls: usize = 0,
+
+    fn now(raw: ?*anyopaque, which: std.Io.Clock) std.Io.Timestamp {
+        if (which != .real) return testing.io.vtable.now(raw, which);
+        const self = active orelse return testing.io.vtable.now(raw, which);
+        std.debug.assert(raw == self.original.userdata);
+        self.calls += 1;
+        return .{ .nanoseconds = self.wall };
+    }
+};
+
+test "clock dispatch: instance clock owners and Managed defaults use wrapped now with real Io userdata" {
+    var observer: RealIoObserver = .{ .original = testing.io, .wall = 42 };
+    RealIoObserver.active = &observer;
+    defer RealIoObserver.active = null;
+    var vtable = testing.io.vtable.*;
+    vtable.now = RealIoObserver.now;
+    // Every other Io method still receives the real backing userdata. This
+    // wrapper is therefore safe for complete owner creation and destruction.
+    const io: std.Io = .{ .userdata = testing.io.userdata, .vtable = &vtable };
+    var bytes: [8192]u8 = undefined;
+    var memory = kron.MemorySink.initBuffer(&bytes);
+    const runtime = try kron.Runtime.create(testing.allocator, io, .{ .routes = &.{.{ .name = "out", .sink = memory.sink() }}, .clock = kron.Clock.zeroTimestamp() });
+    defer runtime.destroy();
+    var ignored_context: FakeIo = .{ .wall = 999 };
+    var log = runtime.loggerWithInstanceClock(.{ .context = &ignored_context }, "instance");
+    const default_callback = log.owner.clock.real_now;
