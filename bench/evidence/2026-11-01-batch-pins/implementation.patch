+/// Successfully reclaimed records retain their config pins until this small
+/// consumer-local run is flushed. Batch Views must outlive this object.
+/// Changing snapshot/channel publishes the previous run; error unwinding
+/// publishes only the acknowledged prefix before dropping those Views.
+pub const Acknowledgements = struct {
+    snapshot: ?*configurations.Snapshot = null,
+    counter: ?*Atomic(u64) = null,
+    channel: u32 = 0,
+    count: usize = 0,
+
+    pub fn acknowledged(self: *Acknowledgements, snapshot: *configurations.Snapshot, channel: u32, counter: *Atomic(u64)) void {
+        if (self.snapshot != snapshot or self.channel != channel or self.counter != counter) {
+            self.flush();
+            self.snapshot = snapshot;
+            self.channel = channel;
+            self.counter = counter;
+        }
+        self.count += 1;
+    }
+
+    pub fn flush(self: *Acknowledgements) void {
+        if (self.count == 0) return;
+        self.snapshot.?.releaseChannelCount(self.channel, self.count);
+        if (@import("builtin").is_test) _ = TestingAudit.written_updates.fetchAdd(1, .monotonic);
+        _ = self.counter.?.fetchAdd(self.count, .monotonic);
+        self.count = 0;
+    }
+};
