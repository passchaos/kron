+test "batch acknowledgements retain old leases until confirmed pins and Views are released" {
+    const Lease = struct {
+        releases: usize = 0,
+        fn release(raw: *anyopaque) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.releases += 1;
+        }
+    };
+    var owner: Lease = .{};
+    var next_context: u8 = 0;
+    const manager = try configurations.Manager.create(std.testing.allocator, std.testing.io, .{
+        .capacity = 2,
+        .initial_routes = &.{.{ .name = "old", .sink = .{ .context = &owner, .vtable = &EmptySink.vtable }, .release = .{ .context = &owner, .release = Lease.release } }},
+    });
+    defer manager.destroy();
+    var batch = Configurations.init(manager);
+    defer batch.deinit();
+    const old_version = manager.currentVersion();
+    const old = (try batch.select(old_version.generation, old_version.fingerprint)).snapshot();
+    for (0..31) |_| old.retainChannel(64);
+    const replacement = try manager.install(&.{.{ .name = "new", .sink = .{ .context = &next_context, .vtable = &EmptySink.vtable } }}, .{});
+    const current = (try batch.select(replacement.generation, replacement.fingerprint)).snapshot();
+    current.retainChannel(0);
+    var old_written: Atomic(u64) = .init(0);
+    var new_written: Atomic(u64) = .init(0);
+    var acks: Acknowledgements = .{};
+    defer acks.flush();
+    const releases = configurations.TestingAudit.record_pin_releases.load(.monotonic);
+    for (0..31) |_| acks.acknowledged(old, 64, &old_written);
+    try std.testing.expectEqual(@as(usize, 31), old.pendingCount());
+    try std.testing.expectEqual(@as(u64, 0), old_written.load(.monotonic));
+    try std.testing.expectEqual(@as(usize, 0), try manager.collectRetired());
+    acks.acknowledged(current, 0, &new_written);
+    try std.testing.expectEqual(@as(usize, 0), old.pendingCount());
+    try std.testing.expectEqual(@as(u64, 31), old_written.load(.monotonic));
+    try std.testing.expectEqual(@as(usize, 0), owner.releases);
+    acks.flush();
+    acks.flush();
+    try std.testing.expectEqual(@as(usize, 0), current.pendingCount());
+    try std.testing.expectEqual(@as(u64, 1), new_written.load(.monotonic));
+    try std.testing.expectEqual(@as(usize, 2), configurations.TestingAudit.record_pin_releases.load(.monotonic) - releases);
+    try std.testing.expectEqual(@as(usize, 0), try manager.collectRetired());
+    batch.deinit();
+    try std.testing.expectEqual(@as(usize, 1), try manager.collectRetired());
+    try std.testing.expectEqual(@as(usize, 1), owner.releases);
+}
+
+test "batched pin release composes with concurrent producer and cache pin updates" {
+    if (@import("builtin").single_threaded) return error.SkipZigTest;
+    const Producer = struct {
+        snapshot: configurations.Snapshot = .{},
+        start: std.Io.Event = .unset,
+        channel: u32,
+
+        fn run(self: *@This()) void {
+            self.start.waitUncancelable(std.testing.io);
+            for (0..10000) |_| {
+                self.snapshot.retainChannel(self.channel);
+                self.snapshot.releaseChannel(self.channel);
+            }
+        }
+    };
+    for ([_]u32{ 0, 1, 64 }) |channel| {
+        var producer: Producer = .{ .channel = channel };
+        // Model the stable channel-cache or owner pin separately from all
+        // accepted record pins; completing a batch must not consume it.
+        producer.snapshot.retainChannel(channel);
+        for (0..31 * 1000) |_| producer.snapshot.retainChannel(channel);
+        const thread = try std.Thread.spawn(.{}, Producer.run, .{&producer});
+        var written: Atomic(u64) = .init(0);
+        producer.start.set(std.testing.io);
+        for (0..1000) |_| {
+            var acks: Acknowledgements = .{};
+            for (0..31) |_| acks.acknowledged(&producer.snapshot, channel, &written);
+            acks.flush();
+        }
+        // The producer may still be cycling a temporary pin, so wait for its
+        // completion before observing the exact remaining cache-pin count.
+        thread.join();
+        try std.testing.expectEqual(@as(u64, 31000), written.load(.monotonic));
+        try std.testing.expectEqual(@as(usize, 1), producer.snapshot.pendingCount());
+        producer.snapshot.releaseChannel(channel);
+        try std.testing.expectEqual(@as(usize, 0), producer.snapshot.pendingCount());
+    }
+}
