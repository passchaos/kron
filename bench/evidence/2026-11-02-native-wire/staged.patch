+fn canonical(decoded: kron.Event, wire_version: u16, destination: []u8, historical: []u8) ![]const u8 {
+    if (wire_version == 6) return kron.codec.encodeVersioned(.v6, decoded, destination);
+    const wide = try kron.codec.encodeVersioned(.v4, decoded, destination);
+    if (wire_version == 4) return wide;
