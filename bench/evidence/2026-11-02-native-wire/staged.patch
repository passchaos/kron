+        1 => kron.codec.legacy_header_size,
+        3 => kron.codec.previous_header_size,
+        else => return error.UnexpectedAcceptedVersion,
+    };
+    // Preserve exact legacy headers independently from current compact values.
+    var writer = std.Io.Writer.fixed(historical);
+    try kron.codec.writeHeader(decoded, wide.len - (kron.codec.header_size - header_bytes), wire_version, &writer);
+    try writer.writeAll(wide[kron.codec.header_size..]);
+    return writer.buffered();
+}
