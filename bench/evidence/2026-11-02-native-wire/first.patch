+    var damaged: [frozen_payload.len]u8 = frozen_payload.*;
+    for ([_]u8{ 11, 12 }) |tag| {
+        damaged[first_value] = tag;
+        try std.testing.expectError(error.InvalidTag, resolve(&damaged, definition, &scratch));
+    }
