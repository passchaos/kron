+const SnapshotInput = struct { number: u64, text: []const u8, payload: kron.fields.Bytes, optional: ?i32 };
+const SnapshotClock = struct {
+    input: *SnapshotInput,
+    argument_number: *u64,
+    argument_text: *[]const u8,
+    text: *[3]u8,
+    payload: *[3]u8,
+    calls: usize = 0,
+    pub fn nowNs(self: *SnapshotClock) i64 {
+        self.calls += 1;
+        self.input.number = 99;
+        self.input.text = "replacement with a new descriptor";
+        self.input.payload = kron.bytes("replacement");
+        self.input.optional = null;
+        self.argument_number.* = 88;
+        self.argument_text.* = self.text[0..1];
+        self.text[0] = 'z';
+        self.payload[0] = 255;
+        return 456;
+    }
+    fn real(raw: ?*anyopaque, _: std.Io) i64 {
+        const self: *SnapshotClock = @ptrCast(@alignCast(raw.?));
+        return self.nowNs();
+    }
+    fn clock(self: *SnapshotClock) kron.Clock {
+        return .{ .context = self, .real_now = real };
+    }
+};
+const StaticSnapshotClock = struct {
+    var current: ?*SnapshotClock = null;
+    pub fn realNow(_: std.Io) i64 {
+        return current.?.nowNs();
+    }
+};
