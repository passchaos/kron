+//! Public typed capture contracts, including the retained fallback boundaries.
+const std = @import("std");
+const kron = @import("kron");
+const testing = std.testing;
+
+fn NamedInput(comptime count: usize) type {
+    @setEvalBranchQuota(100000);
+    var names: [count][:0]const u8 = undefined;
+    for (&names, 0..) |*name, index| name.* = std.fmt.comptimePrint("field{d}", .{index});
+    return @Struct(.auto, null, &names, &@splat(u64), &@splat(.{}));
+}
+
+fn namedInput(comptime count: usize) NamedInput(count) {
+    var input: NamedInput(count) = undefined;
+    inline for (0..count) |index| @field(input, std.fmt.comptimePrint("field{d}", .{index})) = index;
+    return input;
+}
+
+fn parse(line: []const u8) !std.json.Parsed(std.json.Value) {
+    return std.json.parseFromSlice(std.json.Value, testing.allocator, line, .{});
+}
+
+const CountClock = struct {
+    calls: usize = 0,
+    before_values: usize = 0,
+    before_keys: usize = 0,
+    values_at_clock: usize = 0,
+    keys_at_clock: usize = 0,
+    make_cycle: ?*[1]kron.Value = null,
+    make_duplicate: ?*[2]kron.Field = null,
+    clear_binding: ?*?kron.SchemaBinding = null,
+
+    fn resetAudit(self: *CountClock) void {
+        self.before_values = kron.fields.TestingAudit.visited_values;
+        self.before_keys = kron.fields.TestingAudit.compared_keys;
+    }
+
+    fn real(raw: ?*anyopaque, _: std.Io) i64 {
+        const self: *CountClock = @ptrCast(@alignCast(raw.?));
+        self.calls += 1;
+        self.values_at_clock = kron.fields.TestingAudit.visited_values - self.before_values;
+        self.keys_at_clock = kron.fields.TestingAudit.compared_keys - self.before_keys;
+        if (self.make_cycle) |tree| tree[0] = .{ .array = tree };
+        if (self.make_duplicate) |group| group[1].key = group[0].key;
+        if (self.clear_binding) |binding| binding.* = null;
+        return 123;
+    }
+
+    pub fn nowNs(self: *CountClock) i64 {
+        return real(self, testing.io);
+    }
+
+    fn clock(self: *CountClock) kron.Clock {
+        return .{ .context = self, .real_now = real };
+    }
+};
