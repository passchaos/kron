@@ -0,0 +1,412 @@
+//! Constructs a bounded scalar field layer and consumes it synchronously.
+//! Field descriptors and metadata are fixed before reading the clock; string
+//! and byte contents remain borrowed for the duration of the consumer call.
+const std = @import("std");
+const fields = @import("field.zig");
+const Field = fields.Field;
+const Event = @import("event.zig").Event;
+const Level = @import("level.zig").Level;
+const TraceContext = @import("../telemetry/trace_context.zig").TraceContext;
+const EmitResult = @import("logger.zig").EmitResult;
+
+pub const Meta = struct {
+    level: Level,
+    scope: []const u8,
+    message: []const u8,
+    message_template: bool = false,
+    source: ?std.builtin.SourceLocation = null,
+    trace_context: ?TraceContext = null,
+    route_mask: u64,
+    config_generation: u64,
+};
+
+pub const Outcome = union(enum) {
+    capture_error: anyerror,
+    submit_error: anyerror,
+    result: EmitResult,
+};
+
+/// Node-local lengths for this constructed scalar layer. These are not a
+/// validation credential or a complete wire size. Arguments remain unchecked.
+pub const Captured = struct {
+    event: Event,
+    value_bytes: u64,
+    keys_bytes: u64,
+};
+
+/// Selects only named structs whose members cannot capture an aggregate or a
+/// caller-provided Value. The field budget is checked at capture time so that
+/// a supported 65-field input retains the ordinary TooManyFields result.
+pub fn supports(comptime T: type) bool {
+    return switch (@typeInfo(T)) {
+        .@"struct" => |info| blk: {
+            if (info.is_tuple) break :blk false;
+            inline for (info.fields) |member| {
+                if (!supportsScalar(member.type)) break :blk false;
+            }
+            break :blk true;
+        },
+        else => false,
+    };
+}
+
+fn supportsScalar(comptime T: type) bool {
+    if (T == fields.Bytes or T == fields.Duration or T == fields.Timestamp or T == fields.Secret) return true;
+    return switch (@typeInfo(T)) {
+        .null, .bool, .comptime_int, .comptime_float, .@"enum", .error_set => true,
+        .int => |info| info.bits <= 128,
+        .float => |info| info.bits <= 64,
+        .optional => |info| supportsScalar(info.child),
+        .pointer => |info| blk: {
+            if (info.is_volatile or info.is_allowzero) break :blk false;
+            if (info.size == .slice and info.child == u8) break :blk true;
+            if (info.size == .one) switch (@typeInfo(info.child)) {
+                .array => |array_info| if (array_info.child == u8) break :blk true,
+                else => {},
+            };
+            break :blk false;
+        },
+        else => false,
+    };
+}
+
+/// Captures each named member exactly once into private stack storage. The
+/// consumer receives that borrow after the clock read and must finish using it
+/// before returning. Runtime supplies its own private consumer; this function
+/// neither exports that consumer nor returns a reusable validation proof.
+pub fn capture(
+    context: anytype,
+    meta: Meta,
+    input: anytype,
+    raw_args: []const Field,
+    clock_reader: anytype,
+    comptime consume: anytype,
+) Outcome {
+    const T = @TypeOf(input);
+    if (comptime !supports(T))
+        @compileError("kron runtime capture requires a named struct of supported scalar fields");
+    const members = @typeInfo(T).@"struct".fields;
+    if (comptime members.len > 64) {
+        return .{ .capture_error = error.TooManyFields };
+    } else {
+        var storage: [members.len]Field = undefined;
+        var value_bytes: u64 = 0;
+        var keys_bytes: u64 = 0;
+        inline for (members, 0..) |member, index| {
+            const value = fields.fromAny(@field(input, member.name));
+            storage[index] = .{ .key = member.name, .value = value };
+            value_bytes += scalarBytes(value);
+            keys_bytes += 4 + boundedLength(member.name.len);
+        }
+        // Zig may pass aggregate parameters by reference. Build a private
+        // value before an arbitrary clock callback can mutate caller aliases.
+        const frozen_meta: Meta = .{
+            .level = meta.level,
+            .scope = meta.scope,
+            .message = meta.message,
+            .message_template = meta.message_template,
+            .source = meta.source,
+            .trace_context = meta.trace_context,
+            .route_mask = meta.route_mask,
+            .config_generation = meta.config_generation,
+        };
+        const timestamp = clock_reader.nowNs();
+        var captured: Captured = .{
+            .event = .{
+                .level = frozen_meta.level,
+                .scope = frozen_meta.scope,
+                .message = frozen_meta.message,
+                .message_template = frozen_meta.message_template,
+                .format_args = raw_args,
+                .fields = &storage,
+                .timestamp_ns = timestamp,
+                .route_mask = frozen_meta.route_mask,
+                .config_generation = frozen_meta.config_generation,
+                .trace_id = if (frozen_meta.trace_context) |trace| trace.trace_id else null,
+                .span_id = if (frozen_meta.trace_context) |trace| trace.span_id else null,
+                .trace_flags = if (frozen_meta.trace_context) |trace| trace.flags else 0,
+                .source = frozen_meta.source,
+            },
+            .value_bytes = value_bytes,
+            .keys_bytes = keys_bytes,
+        };
+        const result = consume(context, &captured) catch |err| return .{ .submit_error = err };
+        return .{ .result = result };
+    }
+}
+
+fn boundedLength(length: usize) u64 {
+    comptime std.debug.assert(@bitSizeOf(usize) <= 64);
+    return @min(@as(u64, length), @as(u64, std.math.maxInt(u32)) + 1);
+}
+
+fn scalarBytes(value: fields.Value) u64 {
+    return switch (value) {
+        .null_value => 1,
+        .boolean => 2,
+        .signed, .unsigned => 17,
+        .float, .duration_ns, .timestamp_ns => 9,
+        .string, .bytes => |bytes| 5 + boundedLength(bytes.len),
+        .array, .group => unreachable,
+    };
+}
+
+const test_meta: Meta = .{
+    .level = .info,
+    .scope = "capture.test",
+    .message = "captured",
+    .route_mask = 1,
+    .config_generation = 2,
+};
+
+fn testResult(outcome: Outcome) anyerror!EmitResult {
+    return switch (outcome) {
+        .capture_error, .submit_error => |err| err,
+        .result => |result| result,
+    };
+}
