# Zig build caches, installed binaries and locally fetched package copies.
.zig-cache/
zig-out/
/zig-pkg/

# Native compilation outputs (including one-off cross-platform checks).
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb

# Generated runtime files from examples, recovery and benchmark runs.
*.journal
*.journal.*
!/tests/fixtures/**/*.journal
*.jsonl
*.jsonl.[0-9]*
*.jsonl.lock
*.jsonl.spool
# Benchmark evidence rows are intentionally tracked; runtime JSONL elsewhere is not.
!/bench/evidence/**/*.jsonl
!/bench/cpp_reference/evidence/**/*.jsonl
*.kron
/core
/core.*

# Keep benchmark reports and frozen source evidence; omit generated workload
# files and executable copies. Reports retain source/binary hashes.
/bench/**/artifacts/
/bench/evidence/*/reference-foundation
/bench/evidence/*/reference-foundation_tracing
/bench/evidence/*/reference-kron
/bench/evidence/*/kron-bench-*
/bench/evidence/*/kron-ref-*
/bench/evidence/*/kron-crc-*
/bench/cpp_reference/evidence/*/reference-*

# Raw source snapshots and profiling data are retained outside Git history.
/bench/evidence/**/*.tar
/bench/evidence/**/*.tar.xz
/bench/evidence/**/*.tar.gz
/bench/evidence/**/*.perf.data
/bench/evidence/**/*.perf.data.gz
/bench/evidence/**/*.data
/bench/cpp_reference/evidence/**/*.tar
/bench/cpp_reference/evidence/**/*.tar.xz
/bench/cpp_reference/evidence/**/*.tar.gz
/bench/cpp_reference/evidence/**/*.perf.data
/bench/cpp_reference/evidence/**/*.perf.data.gz
/bench/cpp_reference/evidence/**/*.data
target/

# Python bytecode and operating-system metadata.
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
