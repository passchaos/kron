# Zig build caches, installed binaries and locally fetched package copies.
.zig-cache/
zig-out/
/zig-pkg/

# Native compilation outputs (including one-off cross-platform checks).
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb

# Generated runtime files from examples, recovery and benchmark runs.
*.journal
*.journal.*
!/tests/fixtures/**/*.journal
*.jsonl
*.jsonl.[0-9]*
*.jsonl.lock
*.jsonl.spool
*.kron
/core
/core.*

# Python bytecode and operating-system metadata.
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
