bench/evidence/**/*.json -diff linguist-generated=true
bench/evidence/**/*.jsonl -diff linguist-generated=true
bench/evidence/**/*.log -diff
bench/evidence/**/*.csv -diff
bench/evidence/**/*.data -diff
bench/evidence/**/*.xz -diff
bench/evidence/**/*.gz -diff
bench/evidence/**/*.tar -diff
bench/evidence/**/*.perf.data -diff
bench/cpp_reference/evidence/**/*.json -diff linguist-generated=true
